{
  "name": "frigate-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build --base=/BASE_PATH/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && npm run i18n:check",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "prettier:write": "prettier -u -w --ignore-path .gitignore \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e:build": "vue-tsc --noEmit && vite build --base=/",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:extract:ci": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@cycjimmy/jsmpeg-player": "^6.1.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.70.0",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hls.js": "^1.7.4",
    "i18next": "^26.5.12",
    "i18next-http-backend": "^4.0.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
